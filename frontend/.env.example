# ==============================================================================
# ⚛️ Frontend Environment Variables Template (Public Template for GitHub)
# ==============================================================================
# Instructions:
# 1. For Local Development: Create a .env file and set localhost URLs.
# 2. For Production/Render: Add these variables in your Render Dashboard Environment tab.

# Backend REST API URL (Replace 'your-backend-app' with your deployed service name)
VITE_API_URL=https://your-backend-app.onrender.com/api/v1

# Backend WebSocket URL (Note: use wss:// for secure WebSockets on Render)
VITE_WS_URL=wss://your-backend-app.onrender.com/ws/optimize
