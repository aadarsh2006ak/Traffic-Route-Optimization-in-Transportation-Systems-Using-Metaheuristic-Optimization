# Frontend Environment Variables for Render / Production Deployment
# Local Default: http://127.0.0.1:8000/api/v1 and ws://127.0.0.1:8000/ws/optimize

# Backend REST API URL (Replace with your actual Render backend URL)
VITE_API_URL=https://your-backend-app.onrender.com/api/v1

# Backend WebSocket URL (Note: use wss:// for HTTPS Render URLs)
VITE_WS_URL=wss://your-backend-app.onrender.com/ws/optimize
