# Environment Configuration - QuantumRoute SIH 2026 PS 26137

# Application Settings
PROJECT_NAME="QuantumRoute - SIH 2026 PS 26137"
VERSION="2.0.0"

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quantumroute
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quantumroute

# SQLite Fallback Path
SQLITE_DB_PATH=./data/route_history.db

# QPSO Optimization Defaults
QPSO_DEFAULT_SWARM_SIZE=40
QPSO_DEFAULT_MAX_ITER=500
QPSO_BETA_MAX=1.0
QPSO_BETA_MIN=0.5

# Dynamic Cost Weights: w(i,j,t) = alpha*d + beta*t + gamma*c
WEIGHT_ALPHA=0.4
WEIGHT_BETA=0.4
WEIGHT_GAMMA=0.2

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000
