# ======================================================
# Traffic & Route Optimization - Environment Variables Template
# Copy this file to .env and replace placeholders with your actual keys
# ======================================================

# TomTom Routing & Live Traffic API Key (Optional, fallback is free OSRM)
# Sign up at: https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# OSRM Service Base URL (Default OpenStreetMap routing table)
OSRM_BASE_URL=http://router.project-osrm.org

# Application Environment (development / production)
ENVIRONMENT=development
