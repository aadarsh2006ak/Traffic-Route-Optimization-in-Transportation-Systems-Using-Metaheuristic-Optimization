# ====================================================================
# ⚛️ QUANTUM ROUTE OPTIMIZER - MASTER ENVIRONMENT CONFIGURATION
# Organization: Egreen Quanta | SIH 2026 PS1
# ====================================================================

# --------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# --------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# --------------------------------------------------------------------
# 2. ROAD NETWORK & ROUTING ENGINES (Deliverable 1 & Bonus 1)
# --------------------------------------------------------------------
# OpenStreetMap Routing Machine (OSRM) URL (Free, no key required)
OSRM_BASE_URL=http://router.project-osrm.org

# Optional: TomTom Live Traffic API Key (Used for real-time traffic flow validation)
# Sign up at: https://developer.tomtom.com/
TOMTOM_API_KEY=zgRGmzIN9fkdtiICvR5bfsQzKA8fVJlQ

# Optional: Google Maps & Route Optimization API Key (Bonus 3: Commercial Baseline)
# If left blank, system uses built-in high-fidelity Clarke-Wright savings baseline solver
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTE_OPTIMIZATION_API_KEY=

# --------------------------------------------------------------------
# 3. DATABASE PERSISTENCE (Bonus 5)
# --------------------------------------------------------------------
# Path to SQLite database file for optimization runs and benchmark history
SQLITE_DB_PATH=./data/route_history.db

# --------------------------------------------------------------------
# 4. COMPUTER VISION ROAD HAZARD DETECTION (Bonus 4)
# --------------------------------------------------------------------
# Minimum confidence threshold for CV hazard bounding box detection (0.0 to 1.0)
CV_CONFIDENCE_THRESHOLD=0.55
# Dynamic hazard penalty multiplier factor (kp in mathematical formulation)
CV_HAZARD_PENALTY_FACTOR=2.5

# --------------------------------------------------------------------
# 5. FRONTEND (React + Vite) ENVIRONMENT VARIABLES
# --------------------------------------------------------------------
# Backend REST API endpoint for frontend client
VITE_API_URL=http://127.0.0.1:8000/api/v1
# Live WebSocket endpoint for real-time convergence streaming
VITE_WS_URL=ws://127.0.0.1:8000/ws/optimize
