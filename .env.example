# ====================================================================
# ⚛️ Quantum Route Optimizer - Master Environment Configuration Template
# ====================================================================

# --------------------------------------------------
# 1. BACKEND (FastAPI) CONFIGURATION (Render Web Service)
# --------------------------------------------------
ENVIRONMENT=production
PYTHON_VERSION=3.10.12
PORT=8000
HOST=0.0.0.0

# Road Routing Engine (Default: Free OpenStreetMap OSRM)
OSRM_BASE_URL=http://router.project-osrm.org

# Optional: TomTom Live Traffic API Key (if not provided, falls back to free OSRM + Gaussian traffic sim)
TOMTOM_API_KEY=

# --------------------------------------------------
# 2. FRONTEND (React + Vite) CONFIGURATION (Render Static Site)
# --------------------------------------------------
# Backend REST API Endpoint (Include /api/v1 at the end)
VITE_API_URL=https://quantum-route-backend.onrender.com/api/v1

# Backend WebSocket Endpoint (Use wss:// for HTTPS Render URLs)
VITE_WS_URL=wss://quantum-route-backend.onrender.com/ws/optimize
